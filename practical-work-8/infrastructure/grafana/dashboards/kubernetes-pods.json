{
  "dashboard": {
    "id": null,
    "uid": "kubernetes-pods",
    "title": "Kubernetes Pods",
    "tags": ["kubernetes", "pods"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Pod CPU Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"task-management\",container!=\"\",container!=\"POD\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Pod Memory Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"task-management\",container!=\"\",container!=\"POD\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Pod Restart Count",
        "type": "stat",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"task-management\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Pods Running",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 14 },
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"task-management\",phase=\"Running\"})",
            "legendFormat": "Running Pods"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Pods Pending",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 14 },
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"task-management\",phase=\"Pending\"}) or vector(0)",
            "legendFormat": "Pending Pods"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Pods Failed",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 14 },
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"task-management\",phase=\"Failed\"}) or vector(0)",
            "legendFormat": "Failed Pods"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Network I/O (Receive)",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
        "targets": [
          {
            "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"task-management\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Network I/O (Transmit)",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
        "targets": [
          {
            "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"task-management\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 20
            }
          }
        }
      }
    ]
  },
  "overwrite": true
}
